<% const page = htmlWebpackPlugin.options.outagePage; const image = name => page.imageBaseUrl + name; %><!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="content-type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width">
    <title><%= page.title %></title>
    <style type="text/css">
      /*
       * Colors match src/_colors.scss, which this inline stylesheet can't import:
       * #855CD6 $ui-purple-dark, #7854C0 $ui-purple-darker, #575E75 $type-gray.
       * Text on them, or them on white, meets WCAG AA contrast.
       */
      * {
        margin: 0;
      }
      html, body {
        height: 100%;
        background-color: #855CD6;
      }

      .page {
        min-height: 100%;
        background-color: #855CD6;
        font-weight: 500;
      }
      .page:after {
        content: "";
        display: block;
      }

      .header-wrapper {
        width: 100%;
        height: 10vh;
      }
      .header-content {
        width: calc(100% - 2rem);
        padding: 1rem;
      }

      .main {
        width: 100%;
        min-height: calc(100vh - 100px - 4vw);
      }
      .content {
        width: 90vw;
        max-width: 45rem;
        margin: 0 auto;
        text-align: center;
        font-family: "Helvetica Neue", "Helvetica", Arial, sans-serif;
        color: white;
        /* hack to prevent content from shifting when scrollbar appears; see
        https://stackoverflow.com/a/30293718/2308190 */
        padding-left: calc(100vw - 100%);
      }
      .content a {
        color: white;
      }
      hr {
        border-width: 0;
        border-top-style: solid;
        border-top-width: 1px;
        border-color: white;
        opacity: 25%;
        margin: 2rem 0;
      }
      img.main-img {
        width: 300px;
        height: 200px;
      }
      h1 {
        font-size: 2rem;
        margin: 1.5rem 1rem 2.5rem 1rem;
      }
      h2 {
        font-size: 1.125rem;
        margin: 1rem 1rem 2.25rem 1rem;
      }
      h2.reload {
        cursor: pointer;
        pointer-events: all;
      }
      h2.reload:before {
        margin-top: 0;
        margin-left: -2.25rem;
        content:'';
        background: url('<%= image('reload.svg') %>');
        height: 66px; /*height of image*/
        width: 63px;  /*width of image*/
        position: absolute;
        background-size: 24px 24px;
        background-repeat: no-repeat;
      }
      p {
        font-size: 1rem;
        line-height: 1.5rem;
        margin: 1rem 1rem 1.5rem 1rem;
      }
      .narrow {
        padding: 0 10%;
      }
      button {
        cursor: pointer;
        border: 0;
        background-color: white;
        box-shadow: none;
        border-radius: .25rem;
        padding: 1rem 1.5rem;
      }
      button span {
        font-size: 1rem;
        color: #855CD6;
        font-weight: 600;
      }

      .hidden {
        display: none;
      }
      .showing {
        display: inline-block;
      }
      .grid-wrapper {
        min-height: 100%;
        /* display: flex; */
        margin-bottom: 2rem;
      }
      .grid-content {
        /* display: inline-block; */
      }
      .grid-content .grid-box {
        width: 16rem;
        display: inline-block;
        background-color: white;
        font-size: 1rem;
        color: #855CD6;
        font-weight: 600;
        border-radius: .5rem;
        padding: 1rem 1rem;
        margin: 0.5rem;
        text-align: left;
        vertical-align: top;
      }
      .os-name-row {
        margin-bottom: 0.25rem;
        display: flex;
        align-items: center;
      }
      .os-name-img {
      }
      .os-name-text {
        color: #575E75;
        line-height: 1.25rem;
        margin-left: 0.5rem;
      }
      .os-version {
        color: #575E75;
        font-size: 0.75rem;
        font-weight: 400;
      }
      .download-link-row {
        margin-top: 0.75rem;
        display: flex;
        align-items: center;
      }
      .store-img {
        flex: 1;
        height: 2.625rem;
      }
      .store-img img {
        height: 2.5rem;
      }
      .vertical-separator-left {
        border-right: 1px solid #d9d9d9;
        height: 2rem;
        flex: 1;
      }
      .vertical-separator-right {
        flex: 1;
      }
      .download-link {
        flex: 1;
        padding: .25rem 0.125rem .25rem 0;
      }
      .download-link a {
        color: #855CD6;
        text-decoration: none;
      }

      .actions button {
        margin: 0.25rem;
      }
      .editor-overlay {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 10;
        display: flex;
        flex-direction: column;
        background-color: white;
      }
      .editor-overlay[hidden] {
        display: none;
      }
      .editor-bar {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        padding: 0.375rem 0.75rem;
        background-color: #7854C0;
        color: white;
        font-family: "Helvetica Neue", "Helvetica", Arial, sans-serif;
        font-size: 0.875rem;
      }
      .editor-bar button {
        padding: 0.375rem 0.75rem;
        margin-right: 0.75rem;
      }
      .editor-bar button span {
        font-size: 0.875rem;
      }
      .editor-overlay iframe {
        flex: 1;
        width: 100%;
        border: 0;
      }
      html.editor-open, html.editor-open body {
        overflow: hidden;
      }
      /* The editor covers the page; hiding the page also keeps keyboard focus and screen readers out of it. */
      html.editor-open .page {
        visibility: hidden;
      }
    </style>
    <script language="JavaScript">
      var toggle = function (elem) {
        // If the element is visible, hide it
        if (window.getComputedStyle(elem).display === 'block') {
          elem.style.display = 'none';
          return;
        }
        // Otherwise, show it
        elem.style.display = 'inline-block';
      };
      // The editor picks its language from its own URL or the browser, so pass along the language the visitor chose
      // on Scratch, if any. Language codes need no decoding, and the editor ignores codes it doesn't support.
      const editorSrc = () => {
        const url = new URL(<%= JSON.stringify(page.editorUrl) %>);
        const cookie = document.cookie.split('; ').find(c => c.startsWith('scratchlanguage='));
        if (cookie) {
          url.searchParams.set('locale', cookie.slice('scratchlanguage='.length));
        }
        return url.href;
      };
      // The editor loads only when someone asks for it, so visitors who just read the message don't download it.
      // Hiding the overlay keeps the frame, and the project in it, alive for when they come back.
      const openEditor = () => {
        const overlay = document.getElementById('editor-overlay');
        if (!overlay.querySelector('iframe')) {
          const frame = document.createElement('iframe');
          frame.title = 'Scratch editor';
          frame.allow = 'camera; microphone; fullscreen';
          frame.allowFullscreen = true;
          frame.src = editorSrc();
          overlay.appendChild(frame);
        }
        overlay.hidden = false;
        document.documentElement.classList.add('editor-open');
        document.getElementById('editor-back').focus();
      };
      const closeEditor = () => {
        document.getElementById('editor-overlay').hidden = true;
        document.documentElement.classList.remove('editor-open');
        document.getElementById('make-project').focus();
      };
      // Handler when the DOM is fully loaded
      var onLoaded = function() {
        document.getElementById('make-project').onclick = openEditor;
        document.getElementById('editor-back').onclick = closeEditor;
        // Listen for click events
        var actionShowElements = document.getElementsByClassName('toggleShowing');
        if (actionShowElements && actionShowElements.length) {
          for (var i = 0; i < actionShowElements.length; i++) {
            actionShowElements[i].onclick = function() {
              var hiddenElements = document.getElementsByClassName('hidden');
              if (hiddenElements && hiddenElements.length) {
                for (var j = 0; j < hiddenElements.length; j++) {
                  hiddenElements[j].style.display = 'inline-block';
                };
              }
              var showingElements = document.getElementsByClassName('showing');
              if (showingElements && showingElements.length) {
                for (var j = 0; j < showingElements.length; j++) {
                  showingElements[j].style.display = 'none';
                };
              }
            };
          }
        }
      };
      // wait until document loaded to assign onclick handlers
      if (document.readyState === "complete" ||
        (document.readyState !== "loading" && !document.documentElement.doScroll)) {
        onLoaded();
      } else {
        document.addEventListener("DOMContentLoaded", onLoaded);
      }
    </script>
  </head>
  <body>
    <div class="page">
      <div class="header-wrapper">
        <div class="header-content">
          <img src="<%= image('logo_sm.png') %>" width="80px" alt="Scratch" />
        </div>
      </div>
      <div class="main">
        <div class="content">
          <img src="<%= require('./images/' + page.illustration).default %>" alt="" />
          <h1><%= page.heading %></h1>
          <% if (page.showReload) { %><h2 class="reload" onclick="location.reload()">Try reloading the page in a few minutes</h2>
          <% } %><hr>
          <div class="narrow">
            <p>
              While the website is <%= page.websiteStatus %>, you can keep making projects here, or use the Scratch App
              to make projects offline. Use &ldquo;Save to your computer&rdquo; in the editor to keep your work.
            </p>
          </div>
          <div class="actions">
            <button id="make-project" type="button"><span>Make a project now</span></button>
            <button class="toggleShowing showing"><span>Download Scratch App</span></button>
          </div>
          <div class="grid-wrapper hidden">
            <div class="grid-content">
              <div class="grid-box">
                <div class="os-name-row">
                  <div class="os-name-img">
                    <img src="<%= image('windows-logo.svg') %>" width="28px" alt="" />
                  </div>
                  <div class="os-name-text">Windows</div>
                </div>
                <div class="os-version">Windows 10+</div>
                <div class="download-link-row">
                  <div class="store-img">
                    <a href="https://www.microsoft.com/store/apps/9pfgj25jl6x3?cid=storebadge&ocid=badge">
                      <img src="<%= image('windows-store-badge.svg') %>" alt="Get it from Microsoft" />
                    </a>
                  </div>
                  <div class="vertical-separator-left"></div>
                  <div class="vertical-separator-right"></div>
                  <div class="download-link"><a href="https://downloads.scratch.mit.edu/desktop/Scratch%20Setup.exe">Download</a></div>
                </div>
              </div>
              <div class="grid-box">
                <div class="os-name-row">
                  <div class="os-name-img">
                    <img src="<%= image('apple-logo.svg') %>" width="28px" alt="" />
                  </div>
                  <div class="os-name-text">macOS</div>
                </div>
                <div class="os-version">macOS 10.13+</div>
                <div class="download-link-row">
                  <div class="store-img">
                    <a href="https://apps.apple.com/us/app/scratch-desktop/id1446785996?mt=12">
                      <img src="<%= image('mac-store-badge.svg') %>" alt="Download on the App Store" />
                    </a>
                  </div>
                  <div class="vertical-separator-left"></div>
                  <div class="vertical-separator-right"></div>
                  <div class="download-link"><a href="https://downloads.scratch.mit.edu/desktop/Scratch.dmg">Download</a></div>
                </div>
              </div>
              <div class="grid-box">
                <div class="os-name-row">
                  <div class="os-name-img">
                    <img src="<%= image('chromeos-logo.svg') %>" width="28px" alt="" />
                  </div>
                  <div class="os-name-text">ChromeOS</div>
                </div>
                <div class="os-version">ChromeOS</div>
                <div class="download-link-row">
                  <div class="store-img">
                    <a href="https://play.google.com/store/apps/details?id=org.scratch">
                      <img src="<%= image('google-play-badge.png') %>" alt="Get it on Google Play" />
                    </a>
                  </div>
                </div>
              </div>
              <div class="grid-box">
                <div class="os-name-row">
                  <div class="os-name-img">
                    <img src="<%= image('android-logo.svg') %>" width="25px" alt="" />
                  </div>
                  <div class="os-name-text">Android (Tablet)</div>
                </div>
                <div class="os-version">Android 6.0+</div>
                <div class="download-link-row">
                  <div class="store-img">
                    <a href="https://play.google.com/store/apps/details?id=org.scratch">
                      <img src="<%= image('google-play-badge.png') %>" alt="Get it on Google Play" />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div id="editor-overlay" class="editor-overlay" hidden>
      <div class="editor-bar">
        <button id="editor-back" type="button"><span>&lsaquo; Back</span></button>
        <span>Use &ldquo;Save to your computer&rdquo; to keep your project.</span>
      </div>
    </div>
  </body>
</html>
